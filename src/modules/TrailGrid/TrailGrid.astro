---
const rows = 10
const columns = 10
---

<main class="trail-grid">
  <h2>AAAAAAAAAAAAAAaaaa</h2>
  <section class="grid" style={`--columns: ${columns};`}>
    {
      new Array(rows * columns).fill(0).map((_, i) => (
        <div
          style={`--grade: ${Math.floor(Math.random() * 12 - 6)};
                --opacity: ${Math.min(Math.random(), 0.2)};
                --hue: ${Math.floor(Math.random() * 45)};`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 20 20"
          >
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M10 3a1 1 0 0 1 1 1v5h5a1 1 0 1 1 0 2h-5v5a1 1 0 1 1-2 0v-5H4a1 1 0 1 1 0-2h5V4a1 1 0 0 1 1-1"
              clip-rule="evenodd"
            />
          </svg>
        </div>
      ))
    }
  </section>
</main>

<script>
  const grid = document.querySelector('.trail-grid .grid') as HTMLElement
  if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
    grid.addEventListener(
      'pointermove',
      (event) => {
        document.querySelector('[data-hover]')?.removeAttribute('data-hover')
        const el = document.elementFromPoint(event.x, event.y) as HTMLElement
        el.dataset.hover = 'true'
      },
      true
    )
    grid.addEventListener(
      'pointerleave',
      (_event) => {
        document.querySelector('[data-hover]')?.removeAttribute('data-hover')
      },
      true
    )
  }
</script>

<style>
  .grid div svg[data-hover] {
    transition-property: opacity, rotate, filter;
    transition-duration: 0s;
    rotate: calc(var(--grade, 0) * 90deg);
    filter: grayscale(0) brightness(1.5);
    opacity: 1;
  }

  .trail-grid {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
    .grid {
      touch-action: none;
      display: grid;
      grid-template-columns: repeat(var(--columns), 1fr);

      &:hover {
        cursor: none;
      }
    }

    div svg {
      --size: 64px;
      width: var(--size);
      height: var(--size);
      margin: auto;
      color: rgba(255, 255, 255, 0.286);
      transition: all 0.2s ease-out;
      padding: 8px;

      transition-property: opacity, rotate, filter;
      transition-duration: 0.8s, 0.4s, 0.6s;
      transition-timing-function: ease-in, ease-out, ease-out;
      scale: 1.3;
      opacity: calc(var(--opacity) * 0.5);
      color: hsl(var(--hue) 80% 50%);
      filter: grayscale(1);

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          transition-property: opacity, rotate, filter;
          transition-duration: 0s;
          rotate: calc(var(--grade, 0) * 90deg);
          filter: grayscale(0) brightness(1.5);
          opacity: 1;
        }
      }
    }
  }
</style>
