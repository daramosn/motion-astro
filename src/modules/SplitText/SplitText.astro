---
const text = 'Hello world'

const characters = text.split('')
---

<section class="split-text">
  <div class="wrapper">
    <di class="container">
      {
        characters.map((char, i) => (
          <div style={{ transitionDelay: 0.1 + 0.03 * i + 's' }}>
            <span>{char}</span>
            <span>{char} </span>
          </div>
        ))
      }
    </di>
  </div>
</section>

<style>
  .split-text {
    min-height: 100vh;
    display: grid;
    place-content: center;

    .container {
      display: inline-flex;
      gap: 4px;
      height: 50%;
      background-color: rgb(125, 187, 242);
      div {
        display: flex;
        flex-direction: column;
        transition: transform 0.3s cubic-bezier(0.42, -0.23, 0.08, 1.37);
        span {
          font-size: 96px;
          line-height: 96px;
        }
      }

      &:hover {
        div {
          transform: translateY(-100%);
        }
      }
    }
  }
</style>
